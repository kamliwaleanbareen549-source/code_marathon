def encode(strs):
    encoded = ""

    for s in strs:
        encoded += str(len(s)) + "#" + s

    return encoded


def decode(encoded):
    result = []
    i = 0

    while i < len(encoded):
        j = encoded.index("#", i)
        length = int(encoded[i:j])

        i = j + 1
        result.append(encoded[i:i + length])

        i += length

    return result


# Example 1
strs = ["Hello", "World"]

encoded = encode(strs)
print("Encoded:", encoded)
print("Decoded:", decode(encoded))