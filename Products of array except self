def productExceptSelf(nums):
    n = len(nums)
    output = [1] * n

    # Product of elements before each index
    left = 1
    for i in range(n):
        output[i] = left
        left *= nums[i]

    # Product of elements after each index
    right = 1
    for i in range(n - 1, -1, -1):
        output[i] *= right
        right *= nums[i]

    return output


# Example 1
nums = [1, 2, 4, 6]
print(productExceptSelf(nums))