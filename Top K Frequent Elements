def topKFrequent(nums, k):
    count = {}

    # Count each number
    for num in nums:
        count[num] = count.get(num, 0) + 1

    # Sort by frequency
    sorted_nums = sorted(count, key=count.get, reverse=True)

    return sorted_nums[:k]


# Example 1
nums = [1, 2, 2, 3, 3, 3]
k = 2

print(topKFrequent(nums, k))